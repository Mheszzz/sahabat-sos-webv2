# URL Backend API Laravel
VITE_API_URL=https://api.sahabatsos.id/api

# Konfigurasi WebSocket Laravel Reverb
VITE_REVERB_HOST=api.sahabatsos.id
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_APP_KEY=sahabat-sos-app-key

# Demo Credentials (WAJIB false di production)
VITE_SHOW_DEMO_CREDENTIALS=false
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=

# Dukungan & Kontak Posko
VITE_SUPPORT_EMAIL=posko@sahabatsos.id
VITE_SUPPORT_PHONE=0812-3456-7890
